                }
              },
              "label": "Vector Store Document Retriever",
              "metadata": {},
              "name": "vectorStoreDocumentRetriever_1",
              "parameters": {
                "similarityThreshold": 0,
                "topK": 4
              },
              "type": "vectorStoreDocumentRetriever/v1/documentRetriever"
            },
            "queryAugmenter": {
              "label": "Query Augmenter",
              "metadata": {},
              "name": "queryAugmenter_1",
