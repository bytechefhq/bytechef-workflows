                  "parameters": {
                    "temperature": 1,
                    "topP": 1,
                    "safePrompt": true
                  },
                  "type": "mistral/v1/model"
                }
              },
              "label": "Query Expander",
              "metadata": {},
              "name": "queryExpander_1",
              "parameters": {
                "includeOriginal": true,
                "numberOfQueries": 3
              },
              "type": "queryExpander/v1/multiQueryExpander"
