                    "metadata": {},
                    "name": "amazonBedrock_1",
                    "parameters": {
                      "response": {
                        "responseFormat": "TEXT"
                      },
                      "temperature": 1,
                      "topP": 1
                    },
                    "type": "amazonBedrock/v1/model"
                  }
                },
                "label": "Query Transformer",
                "metadata": {},
                "name": "queryTransformer_1",
                "parameters": {},
                "type": "queryTransformer/v1/compressionQueryTransformer"
