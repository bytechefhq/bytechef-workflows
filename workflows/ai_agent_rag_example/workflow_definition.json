      "label": "AI Agent",
      "metadata": {
        "ui": {
          "dynamicPropertyTypes": {
            "userPrompt": "STRING"
          }
        }
      },
      "name": "aiAgent_1",
      "parameters": {
        "format": "SIMPLE",
