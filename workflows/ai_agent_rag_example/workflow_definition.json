          },
          "type": "inMemoryChatMemory/v1/chatMemory"
        },
        "rag": {
          "clusterElements": {
            "documentJoiner": {
              "label": "Document Joiner",
              "metadata": {},
              "name": "documentJoiner_1",
              "parameters": {},
              "type": "documentJoiner/v1/concatenationDocumentJoiner"
            },
            "documentRetriever": {
              "clusterElements": {
                "vectorStore": {
                  "clusterElements": {},
                  "label": "Knowledge Base",
                  "metadata": {},
                  "name": "knowledgeBase_1",
                  "parameters": {},
