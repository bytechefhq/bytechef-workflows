{
    "label" : "Classify Gmail emails with OpenAI and forward them to the right team",
    "description" : "",
    "inputs" : [ ],
    "triggers" : [
        {
            "description" : "Polls Gmail and starts a run for each new email. The subject, body, sender and message ID are used by the classification, labelling and forwarding steps.",
            "label" : "New email",
            "name" : "trigger_1",
            "parameters" : {
                "format" : "SIMPLE"
            },
            "type" : "googleMail/v1/newEmailPolling"
        }
    ],
    "tasks" : [
        {
            "clusterElements" : { },
            "description" : "Reads the email's subject, body and sender and returns one label as JSON: Sales, Support, Finance, Operations or HR, or URGENT when none of them fits. The branch below routes on that label.",
            "label" : "Get correct label for the email",
            "metadata" : {
                "ui" : {
                    "dynamicPropertyTypes" : {
                        "userPrompt" : "STRING",
                        "systemPrompt" : "STRING"
                    }
                }
            },
            "name" : "openAi_1",
            "parameters" : {
                "format" : "SIMPLE",
                "response" : {
                    "responseFormat" : "JSON",
                    "responseSchema" : "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"label\":{\"type\":\"string\",\"title\":\"label\",\"enum\":[\"HR\",\"Sales\",\"Support\",\"Finance\",\"Operations\",\"URGENT\"]}},\"required\":[\"label\"],\"type\":\"object\",\"title\":\"label\"}"
                },
                "n" : 1,
                "temperature" : 1,
                "topP" : 1,
                "frequencyPenalty" : 0,
                "presencePenalty" : 0,
                "model" : "gpt-5-mini",
                "userPrompt" : "Subject: ${trigger_1.subject}, body: ${trigger_1.bodyPlain}, sender: ${trigger_1.from}\n\nClassify this email.",
                "systemPrompt" : "Classify the given email into exactly one of the following labels: Sales, Support, Finance, Operations, HR.\nIf none of these labels apply, return URGENT."
            },
            "type" : "openAi/v1/ask"
        },
        {
            "clusterElements" : { },
            "description" : "Routes the email on the label returned by OpenAI. Each case labels the email in Gmail and stores that department's address; an unknown label goes to the default case.",
