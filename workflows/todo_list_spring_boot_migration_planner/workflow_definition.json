{
    "label": "Spring Boot 4 migration planner with a todo list",
    "description": "A chat agent that writes a todo list with the TodoWrite tool for any request with three or more steps, and works through it one task at a time.",
    "inputs": [],
    "triggers": [
        {
            "name": "chat_1",
            "type": "chat/v1/newChatRequest",
            "parameters": {
                "mode": 1
            },
            "label": "New Chat Request"
        }
    ],
    "tasks": [
        {
            "name": "aiAgent_1",
            "type": "aiAgent/v1/streamChat",
            "parameters": {
                "format": "SIMPLE",
                "systemPrompt": "You are a senior Java engineer. For any request with 3 or more distinct steps, first create a todo list with the TodoWrite tool. Keep exactly one task in_progress at a time, mark each task completed as soon as it is done, and update the list after every step. Finish with a short summary.",
                "userPrompt": "${chat_1.message}",
                "response": {
                    "responseFormat": "TEXT"
                }
            },
            "clusterElements": {
                "model": {
                    "name": "anthropic_1",
                    "type": "anthropic/v1/model",
                    "parameters": {
                        "model": "claude-sonnet-5-5",
                        "maxTokens": 16000
                    },
                    "connections": {
                        "anthropic_1": {
                            "componentName": "anthropic",
                            "componentVersion": 1
                        }
                    },
                    "metadata": {
                        "ui": {
                            "dynamicPropertyTypes": {},
                            "fromAi": []
                        }
                    }
                },
                "chatMemory": {
                    "name": "chatMemory_1",
                    "type": "chatMemory/v1/chatMemory",
                    "parameters": {
                        "conversationId": "${chat_1.conversationId}"
                    }
                },
                "tools": [
                    {
                        "name": "aiAgentUtils_1",
                        "type": "aiAgentUtils/v1/todoWriteTool",
                        "parameters": {
                            "response": {
                                "responseFormat": "TEXT"
                            }
                        },
                        "metadata": {
                            "ui": {
                                "dynamicPropertyTypes": {},
                                "fromAi": []
                            }
                        }
                    }
                ]
            },
            "metadata": {
                "ui": {
                    "dynamicPropertyTypes": {}
                }
            },
            "label": "AI Agent"
        },
        {
            "name": "reply_1",
            "type": "chat/v1/responseToRequest",
            "parameters": {
                "message": "${aiAgent_1}"
            },
            "label": "Reply"
        }
    ]
}
