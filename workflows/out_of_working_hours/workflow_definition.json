{
    "label": "Triage after-hours Gmail with OpenAI and auto-reply or alert Slack",
    "description": "Out-of-hours Gmail auto-response with AI urgency triage + log to Google Sheets",
    "inputs": [],
    "triggers": [
        {
            "label": "New Email",
            "description": "Starts a run for each new email in Gmail, delivered through Gmail push notifications. Set the Google Cloud Pub/Sub topic name that Gmail publishes to.",
            "name": "trigger_1",
            "type": "googleMail/v1/newEmail",
            "parameters": {
                "format": "SIMPLE"
            },
            "metadata": {
                "ui": {
                    "dynamicPropertyTypes": {
                        "topicName": "STRING"
                    }
                }
            }
        }
    ],
    "tasks": [
        {
            "label": "Current timestamp",
            "description": "Gets the current date and time in UTC. It is used for the business-hours check and as the timestamp in the log row.",
            "name": "dateHelper_2",
            "type": "dateHelper/v1/getCurrentDate",
            "parameters": {
                "timeZone": "UTC",
                "dateFormat": "yyyy-MM-dd'T'HH:mm:ss"
            },
            "metadata": {
                "ui": {
                    "dynamicPropertyTypes": {}
                }
            }
        },
        {
            "label": "Is business hours?",
            "description": "Checks whether the current time falls within business hours, 09:00-17:00 UTC, Monday to Friday. Adjust the days, hours and time zone to your own.",
            "name": "dateHelper_1",
            "type": "dateHelper/v1/isBusinessHours",
            "parameters": {
                "businessWeekStart": 1,
                "businessWeekEnd": 5,
                "businessHoursStart": "09:00:00",
                "businessHoursEnd": "17:00:00",
                "timeZone": "UTC",
                "date": "${dateHelper_2}"
            },
            "metadata": {
                "ui": {
                    "dynamicPropertyTypes": {
                        "date": "DATE_TIME"
                    }
                }
            }
        },
        {
            "clusterElements": {},
            "description": "Routes on the business-hours check. During business hours (true) nothing happens; outside them (false) the email is triaged, logged and answered.",
            "label": "Is outside working hours?",
            "maxRetries": 0,
            "metadata": {
                "ui": {
                    "dynamicPropertyTypes": {}
                }
            },
            "name": "condition_1",
            "parameters": {
                "rawExpression": true,
                "expression": "${dateHelper_1}",
                "caseTrue": [],
                "caseFalse": [
                    {
                        "label": "AI urgency classification",
                        "description": "Outside business hours: classifies the email's urgency and returns JSON with urgent (true/false) and a short reason.",
                        "name": "openAi_1",
                        "type": "openAi/v1/ask",
                        "parameters": {
                            "model": "gpt-4o-mini",
                            "format": "SIMPLE",
                            "systemPrompt": "You classify incoming customer emails received outside working hours. Return ONLY JSON.",
                            "userPrompt": "Classify urgency for this email.\n\nSubject: ${trigger_1.subject}\nFrom: ${trigger_1.from}\nBody: ${trigger_1.bodyPlain}\n\nReturn JSON with keys: urgent (boolean) and reason (string). ",
                            "response": {
                                "responseFormat": "JSON",
                                "responseSchema": "{\"type\":\"object\",\"properties\":{\"urgent\":{\"type\":\"boolean\"},\"reason\":{\"type\":\"string\"}},\"required\":[\"urgent\",\"reason\"]}"
                            }
                        },
                        "metadata": {
                            "ui": {
                                "dynamicPropertyTypes": {}
                            }
                        }
                    },
                    {
                        "label": "Log to Google Sheets",
                        "description": "Outside business hours: logs the timestamp, sender, subject, body and urgency result to your tracking sheet. Select the spreadsheet and sheet.",
                        "name": "googleSheets_1",
                        "type": "googleSheets/v1/insertRow",
                        "parameters": {
                            "valueInputOption": "RAW",
                            "isTheFirstRowHeader": false,
                            "row": {
                                "Timestamp": "${dateHelper_2}",
                                "From": "${trigger_1.from}",
                                "Subject": "${trigger_1.subject}",
                                "Body": "${trigger_1.bodyPlain}",
                                "Message Id": "${trigger_1.id}",
                                "values": [
                                    "${openAi_1.urgent}",
                                    "${openAi_1.reason}"
                                ]
                            }
                        },
                        "metadata": {
                            "ui": {
                                "dynamicPropertyTypes": {}
                            }
                        }
                    },
                    {
                        "label": "Is it urgent?",
                        "description": "Routes on the urgency result. Urgent emails alert the team on Slack; non-urgent ones get an AI-written reply.",
                        "name": "condition_2",
                        "type": "condition/v1",
                        "parameters": {
                            "rawExpression": true,
                            "expression": "${openAi_1.urgent}",
                            "caseTrue": [
                                {
                                    "label": "OpenAI",
                                    "description": "Urgent: summarises the email into a message for the internal support team. That message is posted to Slack.",
                                    "name": "openAi_2",
                                    "parameters": {
                                        "format": "SIMPLE",
                                        "response": {
                                            "responseFormat": "TEXT"
                                        },
                                        "n": 1,
                                        "temperature": 1,
                                        "topP": 1,
                                        "frequencyPenalty": 0,
                                        "presencePenalty": 0,
                                        "model": "gpt-4o-mini",
                                        "userPrompt": "Generate a message for the internal support team.\n\nSubject: ${trigger_1.subject}\nFrom: ${trigger_1.from}\nBody: ${trigger_1.bodyPlain}\n\nReturn only the message text.",
                                        "systemPrompt": "An incoming email has been classified as URGENT. Summarize the issue clearly and generate a message for the internal team who needs to resolve it."
                                    },
                                    "type": "openAi/v1/ask",
                                    "metadata": {
                                        "ui": {
                                            "dynamicPropertyTypes": {
                                                "userPrompt": "STRING",
                                                "systemPrompt": "STRING"
                                            }
                                        }
                                    }
                                },
                                {
                                    "label": "Urgent auto-reply",
                                    "description": "Urgent: replies to the sender that the message arrived outside working hours, was marked urgent and will be handled as soon as possible.",
                                    "name": "googleMail_2",
                                    "type": "googleMail/v1/replyToEmail",
                                    "parameters": {
                                        "id": "${trigger_1.id}",
                                        "to": [
                                            "${trigger_1.from}"
                                        ],
                                        "bodyType": "plain",
                                        "body": "Thank you for contacting us. This message was received outside of our working hours and has been classified as urgent. It has been forwarded to our team and we will respond as soon as possible once we are available.\n\n— Automated response"
                                    },
                                    "metadata": {
                                        "ui": {
                                            "dynamicPropertyTypes": {
                                                "body": "STRING"
                                            }
                                        }
                                    }
                                },
                                {
                                    "label": "Slack",
                                    "description": "Urgent: posts the summary for the support team to your alert channel. Select the channel.",
                                    "name": "slack_1",
                                    "parameters": {
                                        "text": "${openAi_2}"
                                    },
                                    "type": "slack/v1/sendChannelMessage",
                                    "metadata": {
                                        "ui": {
                                            "dynamicPropertyTypes": {
                                                "text": "STRING"
                                            }
                                        }
                                    }
                                }
                            ],
                            "caseFalse": [
                                {
                                    "label": "OpenAI",
                                    "description": "Not urgent: writes a reply to the customer that solves the issue if possible, or says a team member will follow up.",
                                    "name": "openAi_3",
                                    "parameters": {
                                        "format": "SIMPLE",
                                        "response": {
                                            "responseFormat": "TEXT"
                                        },
                                        "n": 1,
                                        "temperature": 1,
                                        "topP": 1,
                                        "frequencyPenalty": 0,
                                        "presencePenalty": 0,
                                        "model": "gpt-4o-mini",
                                        "userPrompt": "Generate a response message for the customer.\n\nSubject: ${trigger_1.subject}\nFrom: ${trigger_1.from}\nBody: ${trigger_1.bodyPlain}\n\nReturn only the message text.",
                                        "systemPrompt": "An incoming email has been classified as NOT urgent. If the issue can be resolved based on the information provided, generate a helpful and clear response with a solution.If the issue cannot be resolved directly, generate a polite response acknowledging the request and informing the sender that a team member will follow up."
                                    },
                                    "type": "openAi/v1/ask",
                                    "metadata": {
                                        "ui": {
                                            "dynamicPropertyTypes": {
                                                "userPrompt": "STRING",
                                                "systemPrompt": "STRING"
                                            }
                                        }
                                    }
                                },
                                {
                                    "label": "Not urgent auto-reply",
                                    "description": "Not urgent: sends the AI-written reply to the sender, in the same email thread.",
                                    "name": "googleMail_3",
                                    "type": "googleMail/v1/replyToEmail",
                                    "parameters": {
                                        "id": "${trigger_1.id}",
                                        "to": [
                                            "${trigger_1.from}"
                                        ],
                                        "bodyType": "plain",
                                        "body": "${openAi_3}"
                                    },
                                    "metadata": {
                                        "ui": {
                                            "dynamicPropertyTypes": {
                                                "body": "STRING"
                                            }
                                        }
                                    }
                                }
                            ]
                        },
                        "metadata": {
                            "ui": {
                                "dynamicPropertyTypes": {
                                    "expression": "STRING"
                                }
                            }
                        }
                    }
                ]
            },
            "type": "condition/v1"
        }
    ],
    "metadata": {
        "ui": {
            "stickyNotes": [
                {
                    "color": "yellow",
                    "content": "Make sure to set the Properties for the Google Sheets task:\n- Spreadsheet ID\n- Sheet Name\n- Values",
                    "id": "stickyNote_d2aa28a6-4bd8-4a71-8f1f-643d8bdd9383",
                    "position": {
                        "x": 2062.5,
                        "y": 851.5
                    },
                    "size": {
                        "height": 179,
                        "width": 240
                    }
                },
                {
                    "color": "yellow",
                    "content": "Make sure to set the Topic Name property that can be found in your Google Search Console",
                    "id": "stickyNote_77040a15-ce6a-4c34-949f-c37b730365a4",
                    "position": {
                        "x": 1358.5,
                        "y": 50.5
                    },
                    "size": {
                        "height": 100,
                        "width": 240
                    }
                }
            ]
        }
    }
}
